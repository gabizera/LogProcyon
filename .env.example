# LogProcyon — variáveis de ambiente (copie para .env e preencha)
# Deploy é via docker compose. Compose falha de propósito se uma var
# OBRIGATÓRIA estiver faltando — isso é intencional (fail-fast).

# ── OBRIGATÓRIAS ───────────────────────────────────────────────

# Senha do ClickHouse. Gere com: openssl rand -hex 24
CLICKHOUSE_PASSWORD=

# Segredo JWT — mínimo 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=

# Domínio https público (o que o reverse-proxy externo serve).
# Sem isso o backend bloqueia o XHR do frontend (CORS).
CORS_ORIGINS=https://log.seudominio.com.br

# ── OPCIONAIS (têm default) ────────────────────────────────────

# Offset do fuso em horas: -3 BRT/Brasília, -4 AMT/Manaus, 0 UTC
TZ_OFFSET_HOURS=-3

# true = isolamento multi-cliente por allowed_instances (cliente só vê
# o dele). false (default) = todo usuário vê tudo. Para vender acesso
# a clientes, use true.
MULTI_TENANT_MODE=false

# Porta interna onde o reverse-proxy externo encaminha o frontend.
FRONTEND_PORT=80

# Range de portas UDP dedicadas por cliente (1 cliente = 1 porta).
# O backend aloca automaticamente nesse range.
INPUT_PORT_MIN=20000
INPUT_PORT_MAX=20199
